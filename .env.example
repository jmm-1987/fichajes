FLASK_APP=ejecutar:aplicacion
# En producción no defina FLASK_DEBUG o póngalo a 0.
FLASK_DEBUG=1
SECRET_KEY=cambiar-en-produccion-clave-larga-y-aleatoria
# Recomendado en producción: PostgreSQL local en el VPS.
# DATABASE_URL=postgresql+psycopg2://fichajes_app:clave_segura@127.0.0.1:5432/fichajes
# SQLite relativo al directorio del proyecto (tres barras). Absoluto Linux: sqlite:////var/lib/fichajes/app.db
DATABASE_URL=sqlite:///datos/fichajes.db
# Tras Nginx con HTTPS (ver docs/MANUAL_DESPLIEGUE_VPS_UBUNTU_24.md).
DETRAS_DE_PROXY=0
# Logo del kiosco /fichaje-publico y del login. Instancia SFM:
# KIOSK_LOGO_ARCHIVO=logosfm.png
# KIOSK_LOGO_ALT=SFM
HABILITAR_MODULO_PLANIFICACION=1
HABILITAR_BLOQUEO_INTENTOS=1
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO_LOGIN=15
